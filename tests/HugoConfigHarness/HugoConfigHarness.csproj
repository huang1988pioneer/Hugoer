<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <!-- Use the already-built desktop assembly so the harness is offline and
         exercises the same production implementation without restoring NuGet. -->
    <Reference Include="Hugoer">
      <HintPath>..\..\bin\Release\net10.0\win-x64\Hugoer.dll</HintPath>
    </Reference>
  </ItemGroup>
</Project>
