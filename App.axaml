<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Hugoer.App"
             xmlns:local="using:Hugoer"
             xmlns:ae="using:AvaloniaEdit"
             RequestedThemeVariant="Dark">

    <Application.DataTemplates>
        <local:ViewLocator />
    </Application.DataTemplates>

    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://AvaloniaEdit/Themes/Fluent/AvaloniaEdit.xaml" />

        <Style Selector="TextBlock.appTitle">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#F4F7FB"/>
        </Style>

        <Style Selector="TextBlock.pageTitle">
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#F4F7FB"/>
        </Style>

        <Style Selector="TextBlock.sectionTitle">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#E7ECF2"/>
        </Style>

        <Style Selector="TextBlock.muted">
            <Setter Property="Foreground" Value="#9AA3B2"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="LineHeight" Value="20"/>
        </Style>

        <Style Selector="TextBlock.caption">
            <Setter Property="Foreground" Value="#7C8694"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <Style Selector="TextBlock.mono">
            <Setter Property="FontFamily" Value="Consolas, Cascadia Mono, monospace"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <Style Selector="Border.topBar">
            <Setter Property="Background" Value="#12161C"/>
            <Setter Property="BorderBrush" Value="#262C38"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
        </Style>

        <Style Selector="Border.navigationBar">
            <Setter Property="Background" Value="#12161C"/>
            <Setter Property="BorderBrush" Value="#262C38"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
        </Style>

        <Style Selector="Border.navTrack">
            <Setter Property="Background" Value="#0C1016"/>
            <Setter Property="BorderBrush" Value="#262C38"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="3"/>
        </Style>

        <Style Selector="Border.sidebar">
            <Setter Property="Background" Value="#12161C"/>
            <Setter Property="BorderBrush" Value="#262C38"/>
            <Setter Property="BorderThickness" Value="0,0,1,0"/>
        </Style>

        <Style Selector="Border.contentHost">
            <Setter Property="Background" Value="#0E1116"/>
        </Style>

        <Style Selector="Border.card">
            <Setter Property="Background" Value="#171C24"/>
            <Setter Property="BorderBrush" Value="#2A3140"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Padding" Value="18"/>
        </Style>

        <Style Selector="Border.editorBar">
            <Setter Property="Background" Value="#141920"/>
            <Setter Property="BorderBrush" Value="#2A3140"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
        </Style>

        <Style Selector="Border.editorTools">
            <Setter Property="Background" Value="#10141A"/>
            <Setter Property="BorderBrush" Value="#2A3140"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
        </Style>

        <Style Selector="Border.deploymentMonitor">
            <Setter Property="Background" Value="#102029"/>
            <Setter Property="BorderBrush" Value="#28677A"/>
        </Style>

        <Style Selector="Border.pill">
            <Setter Property="Background" Value="#222A34"/>
            <Setter Property="CornerRadius" Value="999"/>
        </Style>

        <Style Selector="Border.codeStats">
            <Setter Property="Background" Value="#102B38"/>
            <Setter Property="BorderBrush" Value="#28677A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
        </Style>

        <Style Selector="ListBox.navList ListBoxItem">
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
            <Setter Property="MinHeight" Value="38"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style Selector="ListBox.navList ListBoxItem:selected /template/ ContentPresenter">
            <Setter Property="Background" Value="#1E3A4F"/>
        </Style>

        <Style Selector="ListBox.navList ListBoxItem:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#1A2838"/>
        </Style>

        <Style Selector="Button">
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="CornerRadius" Value="10"/>
        </Style>

        <Style Selector="Button.accent">
            <Setter Property="Background" Value="#127E9A"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style Selector="Button.accent:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#1593B2"/>
        </Style>

        <Style Selector="TextBox">
            <Setter Property="CornerRadius" Value="8"/>
        </Style>

        <Style Selector="TextBox.codeEditor">
            <Setter Property="AcceptsReturn" Value="True"/>
            <Setter Property="TextWrapping" Value="NoWrap"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="Background" Value="#0D1218"/>
        </Style>

        <Style Selector="TextBox.logBox">
            <Setter Property="Background" Value="#0D1218"/>
            <Setter Property="Padding" Value="10"/>
        </Style>

        <!-- Markdown editor toolbar -->
        <Style Selector="Border.toolGroup">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="#2A3140"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="2"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
        </Style>

        <Style Selector="Border.editorModePill">
            <Setter Property="Background" Value="#123D49"/>
            <Setter Property="BorderBrush" Value="#28677A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="999"/>
        </Style>

        <Style Selector="Border.editorModePill TextBlock">
            <Setter Property="Foreground" Value="#7CDAF9"/>
        </Style>

        <Style Selector="Border.modeToggle">
            <Setter Property="Background" Value="#0C1016"/>
            <Setter Property="BorderBrush" Value="#2A3140"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="3"/>
        </Style>

        <Style Selector="Button.modeBtn">
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="MinHeight" Value="28"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#9AA8B8"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style Selector="Button.modeBtn:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#1C2736"/>
        </Style>

        <Style Selector="Button.modeBtn.selected">
            <Setter Property="Background" Value="#127E9A"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>

        <Style Selector="Button.modeBtn.selected:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#1593B2"/>
        </Style>

        <Style Selector="Button.toolBtn">
            <Setter Property="Padding" Value="9,5"/>
            <Setter Property="MinWidth" Value="34"/>
            <Setter Property="MinHeight" Value="28"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#B7C3D2"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style Selector="Button.toolBtn:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#1C2736"/>
        </Style>

        <Style Selector="Button.toolBtn:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="#22334A"/>
        </Style>

        <!-- AvaloniaEdit markdown editor -->
        <Style Selector="ae|TextEditor.markdownEditor">
            <Setter Property="FontFamily" Value="Cascadia Mono, Consolas, monospace"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="Background" Value="#12161C"/>
            <Setter Property="Padding" Value="10,8"/>
        </Style>

        <Style Selector="TabControl.previewTabs">
            <Setter Property="Background" Value="#0D1218"/>
        </Style>

        <Style Selector="TextBox.sourceViewer">
            <Setter Property="AcceptsReturn" Value="True"/>
            <Setter Property="TextWrapping" Value="NoWrap"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="Background" Value="#0D1218"/>
            <Setter Property="FontFamily" Value="Cascadia Mono, Consolas, monospace"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <!-- ================= 首頁「下一步」英雄卡 ================= -->
        <Style Selector="Border.hero">
            <Setter Property="BorderBrush" Value="#2C4A56"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="18"/>
            <Setter Property="Padding" Value="28,26"/>
            <Setter Property="Background">
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
                    <GradientStop Offset="0" Color="#1C303A"/>
                    <GradientStop Offset="0.42" Color="#171C24"/>
                    <GradientStop Offset="1" Color="#171C24"/>
                </LinearGradientBrush>
            </Setter>
        </Style>

        <Style Selector="Button.hero">
            <Setter Property="Background" Value="#127E9A"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="22,12"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="MinHeight" Value="46"/>
        </Style>

        <Style Selector="Button.hero:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#1593B2"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>

        <Style Selector="Button.hero:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="#0E6A84"/>
        </Style>

        <!-- ================= 頂列的發布按鈕（決策色，僅此一處） ================= -->
        <Style Selector="Button.publish">
            <Setter Property="Background" Value="#8C5E16"/>
            <Setter Property="Foreground" Value="#FFF6E8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style Selector="Button.publish:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#A87422"/>
            <Setter Property="Foreground" Value="#FFF6E8"/>
        </Style>

        <!-- ================= 主要導覽分段 ================= -->
        <Style Selector="Button.navSeg">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#9AA3B2"/>
            <Setter Property="Padding" Value="16,7"/>
            <Setter Property="MinHeight" Value="34"/>
            <Setter Property="CornerRadius" Value="9"/>
        </Style>

        <Style Selector="Button.navSeg:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#1C2632"/>
            <Setter Property="Foreground" Value="#E7ECF2"/>
        </Style>

        <Style Selector="Button.navSeg.selected">
            <Setter Property="Background" Value="#243646"/>
            <Setter Property="Foreground" Value="#F7FBFF"/>
        </Style>

        <Style Selector="Button.navSeg.selected /template/ ContentPresenter">
            <Setter Property="Background" Value="#243646"/>
            <Setter Property="Foreground" Value="#F7FBFF"/>
        </Style>

        <Style Selector="Button.navSeg.selected:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#2C4254"/>
            <Setter Property="Foreground" Value="#F7FBFF"/>
        </Style>

        <!-- ================= 頂列的命令搜尋列 ================= -->
        <Style Selector="Button.searchBar">
            <Setter Property="Background" Value="#0C1016"/>
            <Setter Property="BorderBrush" Value="#2A3140"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="MinHeight" Value="36"/>
        </Style>

        <Style Selector="Button.searchBar:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#171C24"/>
        </Style>

        <Style Selector="Border.kbd">
            <Setter Property="Background" Value="#222A34"/>
            <Setter Property="BorderBrush" Value="#343E4E"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
        </Style>

        <!-- ================= 清單型按鈕（最近文章、進階選單、快捷動作） ================= -->
        <Style Selector="Button.rowItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Margin" Value="0,1"/>
        </Style>

        <Style Selector="Button.rowItem:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#1A2838"/>
        </Style>

        <Style Selector="Button.quickAction">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#E7ECF2"/>
        </Style>

        <Style Selector="Button.quickAction:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#1C2632"/>
        </Style>

        <Style Selector="Button.linkish">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#7CDAF9"/>
            <Setter Property="Padding" Value="6,3"/>
            <Setter Property="FontSize" Value="12.5"/>
        </Style>

        <Style Selector="Button.linkish:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#16222E"/>
            <Setter Property="Foreground" Value="#A9E8FF"/>
        </Style>

        <!-- ================= 命令面板 Ctrl+K ================= -->
        <Style Selector="Border.paletteOverlay">
            <Setter Property="Background" Value="#D60E1116"/>
        </Style>

        <Style Selector="Border.paletteCard">
            <Setter Property="Background" Value="#1A2028"/>
            <Setter Property="BorderBrush" Value="#3A4658"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Padding" Value="16"/>
        </Style>

        <Style Selector="TextBox.paletteInput">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="CaretBrush" Value="#7CDAF9"/>
        </Style>

        <Style Selector="TextBox.paletteInput /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <Style Selector="ListBox.paletteList ListBoxItem">
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="CornerRadius" Value="8"/>
        </Style>

        <Style Selector="TextBox.markdownOutput">
            <Setter Property="AcceptsReturn" Value="True"/>
            <Setter Property="AcceptsTab" Value="True"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Padding" Value="16,14"/>
            <Setter Property="Background" Value="#12161C"/>
            <Setter Property="Foreground" Value="#E7ECF1"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontFamily" Value="Cascadia Mono, Consolas, monospace"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="CaretBrush" Value="#7CDAF9"/>
        </Style>
    </Application.Styles>
</Application>
