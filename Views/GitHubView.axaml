<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Hugoer.ViewModels"
             x:Class="Hugoer.Views.GitHubView"
             x:DataType="vm:GitHubViewModel">

    <ScrollViewer HorizontalScrollBarVisibility="Disabled" Padding="24">
        <StackPanel Spacing="16" MaxWidth="980">
            <TextBlock Text="GitHub Pages" Classes="pageTitle"/>
            <TextBlock Text="將網站推上 GitHub，以 GitHub Actions 部署 Pages，並查詢上線狀態。"
                       Classes="muted" TextWrapping="Wrap"/>

            <Border Classes="card">
                <StackPanel Spacing="8">
                    <TextBlock Text="本機工具" Classes="sectionTitle"/>
                    <TextBlock Text="{Binding GitStatus}"/>
                    <TextBlock Text="{Binding GhStatus}"/>
                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
                        <Button Content="重新整理狀態" Command="{Binding RefreshCommand}" IsEnabled="{Binding !IsBusy}"/>
                        <Button Content="GitHub 登入 (gh auth)" Command="{Binding LoginCommand}" IsEnabled="{Binding !IsBusy}"/>
                        <Button Content="只加入 workflow 檔" Command="{Binding AddWorkflowOnlyCommand}"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Classes="card" BorderBrush="#0E7490" BorderThickness="1">
                <StackPanel Spacing="12">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Spacing="3">
                            <TextBlock Text="連結既有 GitHub Repository" Classes="sectionTitle"/>
                            <TextBlock Text="貼上 repository 網址，Hugoer 會辨識 Pages 類型、同步 baseURL，安全合併遠端內容後部署。"
                                       Classes="caption" TextWrapping="Wrap"/>
                        </StackPanel>
                        <Border Grid.Column="1" Classes="pill" Padding="10,4" VerticalAlignment="Top">
                            <TextBlock Text="推薦" Foreground="#67D8FF" FontWeight="SemiBold" FontSize="12"/>
                        </Border>
                    </Grid>

                    <TextBox Text="{Binding RepositoryUrl}"
                             PlaceholderText="https://github.com/owner/owner.github.io"
                             FontFamily="Consolas, Cascadia Mono, monospace"/>

                    <Border Background="#101720" BorderBrush="#2A3648" BorderThickness="1"
                            CornerRadius="8" Padding="12">
                        <TextBlock Text="{Binding RepositoryTargetSummary}" TextWrapping="Wrap"
                                   Classes="muted" LineHeight="20"/>
                    </Border>

                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Spacing="3" VerticalAlignment="Center">
                            <CheckBox Content="將 hugo.toml 的 baseURL 同步為建議 Pages 網址"
                                      IsChecked="{Binding SyncRecommendedBaseUrl}"/>
                            <TextBlock Text="若遠端已有 README，會先安全取得並保留；遇到衝突立即停止，不會 force push。"
                                       Classes="caption" TextWrapping="Wrap"/>
                        </StackPanel>
                        <Button Grid.Column="1" Content="連結、推送並啟用 Pages"
                                Classes="accent" Command="{Binding ConnectExistingRepositoryCommand}"
                                IsEnabled="{Binding CanConnectRepository}" Margin="16,0,0,0"
                                VerticalAlignment="Center"/>
                    </Grid>
                </StackPanel>
            </Border>

            <Grid ColumnDefinitions="*,*">
                <Border Classes="card" Margin="0,0,6,0">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Repository 連線" Classes="sectionTitle"/>
                        <TextBlock Text="{Binding RemoteSummary}" Classes="muted" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
                <Border Classes="card" Grid.Column="1" Margin="6,0,0,0">
                    <StackPanel Spacing="8">
                        <TextBlock Text="GitHub Pages 狀態" Classes="sectionTitle"/>
                        <TextBlock Text="{Binding PagesSummary}" Classes="muted" TextWrapping="Wrap"/>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="查詢 Pages 狀態" Command="{Binding RefreshPagesStatusCommand}"
                                    IsEnabled="{Binding !IsBusy}"/>
                            <Button Content="開啟網站" Command="{Binding OpenPagesUrlCommand}"/>
                            <Button Content="啟用 Pages (Actions)" Command="{Binding EnablePagesCommand}"
                                    IsEnabled="{Binding !IsBusy}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <Border Classes="card">
                <StackPanel Spacing="12">
                    <TextBlock Text="建立新的 GitHub Repository" Classes="sectionTitle"/>
                    <Grid ColumnDefinitions="120,*" RowDefinitions="Auto,Auto,Auto">
                        <TextBlock Text="Repo 名稱" VerticalAlignment="Center" Margin="0,0,0,8"/>
                        <TextBox Grid.Column="1" Text="{Binding RepoName}"
                                 PlaceholderText="my-hugo-site（只填新 repository 名稱）" Margin="0,0,0,8"/>
                        <TextBlock Grid.Row="1" Text="可見性" VerticalAlignment="Center" Margin="0,0,0,8"/>
                        <CheckBox Grid.Row="1" Grid.Column="1" Content="Public repository"
                                  IsChecked="{Binding IsPublicRepo}" Margin="0,0,0,8"/>
                        <TextBlock Grid.Row="2" Text="Commit 訊息" VerticalAlignment="Center"/>
                        <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding CommitMessage}"/>
                    </Grid>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="建立新 Repo + 推送 + 啟用 Pages" Classes="accent"
                                Command="{Binding CreateAndDeployCommand}"
                                IsEnabled="{Binding !IsBusy}"/>
                        <Button Content="建置、提交並推送更新" Command="{Binding PushCommand}"
                                IsEnabled="{Binding !IsBusy}"/>
                    </StackPanel>
                    <TextBlock Classes="caption" TextWrapping="Wrap"
                               Text="流程：本機 Hugo Production Build → 寫入 .github/workflows/hugo.yml → git commit/push → GitHub Actions 建置並部署到 GitHub Pages。建置失敗時不會推送；請先 gh auth login。"/>
                </StackPanel>
            </Border>

            <Border Classes="card">
                <StackPanel Spacing="8">
                    <TextBlock Text="操作日誌" Classes="sectionTitle"/>
                    <TextBox Text="{Binding Log}"
                             IsReadOnly="True"
                             AcceptsReturn="True"
                             Classes="logBox"
                             MinHeight="160"
                             FontFamily="Consolas, Cascadia Mono, monospace"/>
                    <TextBlock Text="{Binding StatusMessage}" Classes="muted"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
