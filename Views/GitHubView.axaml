<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Hugoer.ViewModels"
             xmlns:models="using:Hugoer.Models"
             x:Class="Hugoer.Views.GitHubView"
             x:DataType="vm:GitHubViewModel">

    <ScrollViewer HorizontalScrollBarVisibility="Disabled" Padding="24">
        <StackPanel Spacing="16" MaxWidth="980">
            <TextBlock Text="Git 部署" Classes="pageTitle"/>
            <TextBlock Text="將 Hugo 網站推到 GitHub、GitLab、Codeberg 或 Bitbucket。貼上該平台網址會自動切換。GitHub 可自動啟用 Pages；GitLab 加入 CI；Codeberg 發布 pages 分支；Bitbucket 靜態網站發布到 workspace.bitbucket.io。"
                       Classes="muted" TextWrapping="Wrap"/>

            <Border Classes="card" BorderBrush="#0E7490" BorderThickness="1">
                <StackPanel Spacing="10">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <StackPanel Spacing="3">
                            <TextBlock Text="發佈策略" Classes="sectionTitle"/>
                            <TextBlock Text="{Binding DeploymentModeSummary}" Classes="muted" TextWrapping="Wrap"/>
                        </StackPanel>
                        <Border Grid.Column="1" Classes="pill" Padding="10,4" VerticalAlignment="Top">
                            <StackPanel>
                                <TextBlock Text="預設遠端" Foreground="#67D8FF" FontWeight="SemiBold" FontSize="12"
                                           IsVisible="{Binding IsRemoteDeploymentMode}"/>
                                <TextBlock Text="本機備援" Foreground="#F6C85F" FontWeight="SemiBold" FontSize="12"
                                           IsVisible="{Binding IsLocalDeploymentMode}"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                        <TextBlock Text="主要路徑" VerticalAlignment="Center"/>
                        <ComboBox Grid.Column="1"
                                  ItemsSource="{Binding DeploymentModeOptions}"
                                  SelectedItem="{Binding SelectedDeploymentMode}"
                                  HorizontalAlignment="Stretch">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="models:DeploymentModeOption">
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding Description}" Classes="caption" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <CheckBox Grid.Column="2"
                                  Content="遠端失敗時自動本機備援"
                                  IsChecked="{Binding AllowLocalDeploymentFallback}"
                                  VerticalAlignment="Center"
                                  IsVisible="{Binding IsRemoteDeploymentMode}"/>
                    </Grid>
                    <TextBlock Classes="caption" TextWrapping="Wrap"
                               Text="遠端優先會直接提交 repository，由 GitHub Actions／平台工作流程建置 Pages；不要求本機 Hugo。只有遠端推送失敗，或你明確選擇本機路徑時，才會使用 public/ 本機建置。"/>
                </StackPanel>
            </Border>

            <Border Classes="card">
                <StackPanel Spacing="8">
                    <TextBlock Text="本機工具" Classes="sectionTitle"/>
                    <TextBlock Text="{Binding GitStatus}"/>
                    <TextBlock Text="{Binding GhStatus}"/>
                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
                        <Button Content="重新整理狀態" Command="{Binding RefreshCommand}" IsEnabled="{Binding !IsBusy}"/>
                        <Button Content="GitHub 登入 (gh auth)" Command="{Binding LoginCommand}"
                                IsEnabled="{Binding !IsBusy}"
                                IsVisible="{Binding IsGitHubProvider}"/>
                        <Button Content="只加入部署設定" Command="{Binding AddWorkflowOnlyCommand}"
                                IsVisible="{Binding HasLocalSite}"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Classes="card">
                <StackPanel Spacing="10">
                    <Grid ColumnDefinitions="Auto,220,*" ColumnSpacing="12">
                        <TextBlock Text="Git 平台" Classes="sectionTitle" VerticalAlignment="Center"/>
                        <ComboBox Grid.Column="1"
                                  ItemsSource="{Binding ProviderOptions}"
                                  SelectedItem="{Binding SelectedProvider}"
                                  HorizontalAlignment="Stretch">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="models:GitHostingProviderOption">
                                    <TextBlock Text="{Binding DisplayName}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <TextBlock Grid.Column="2" Text="{Binding ProviderHint}"
                                   Classes="muted" TextWrapping="Wrap" VerticalAlignment="Center"/>
                    </Grid>

                    <Grid ColumnDefinitions="Auto,*,Auto,*" ColumnSpacing="10" RowSpacing="8">
                        <TextBlock Text="帳號／Workspace" VerticalAlignment="Center"/>
                        <TextBox Grid.Column="1" Text="{Binding ProviderAccount}"
                                 PlaceholderText="例如 owner 或 workspace"/>
                        <TextBlock Grid.Column="2" Text="Pages 網址" VerticalAlignment="Center"/>
                        <TextBox Grid.Column="3" Text="{Binding ProviderPagesUrl}"
                                 PlaceholderText="可留空，使用平台建議網址"/>
                        <TextBlock Grid.Row="1" Text="Repository URL" VerticalAlignment="Center"/>
                        <TextBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3"
                                 Text="{Binding RepositoryUrl}"
                                 PlaceholderText="目前所選平台的 repository / Pages 網址"
                                 FontFamily="Consolas, Cascadia Mono, monospace"/>
                        <TextBlock Grid.Row="2" Text="Commit 訊息" VerticalAlignment="Center"/>
                        <TextBox Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3"
                                 Text="{Binding CommitMessage}"
                                 PlaceholderText="留空自動產生：Update site via Hugoer yyyyMMdd-N"/>
                    </Grid>

                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Button Content="儲存此平台設定" Classes="accent"
                                Command="{Binding SaveProviderSettingsCommand}"/>
                        <TextBlock Text="{Binding ProviderSettingsStatus}" Classes="caption"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="每個平台各自保存 repository、帳號、Pages 網址與提交偏好；切換平台不會覆蓋其他平台設定。Git 憑證由系統 credential manager 管理，不寫入 Hugoer 設定檔。"
                               Classes="caption" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <Border Classes="card" BorderBrush="#0E7490" BorderThickness="1"
                    IsVisible="{Binding !HasLocalSite}">
                <StackPanel Spacing="12">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Spacing="3">
                            <TextBlock Text="從 Git 平台複製到本機" Classes="sectionTitle"/>
                            <TextBlock Text="本機還沒有網站時，可貼上 GitHub / GitLab / Codeberg / Bitbucket repository 或 Pages 網址，複製到本機後開啟。私人 repository 請先設定該平台的 Git 憑證。"
                                       Classes="caption" TextWrapping="Wrap"/>
                        </StackPanel>
                        <Border Grid.Column="1" Classes="pill" Padding="10,4" VerticalAlignment="Top">
                            <TextBlock Text="本機沒有網站" Foreground="#67D8FF" FontWeight="SemiBold" FontSize="12"/>
                        </Border>
                    </Grid>

                    <TextBox Text="{Binding RepositoryUrl}"
                             PlaceholderText="https://github.com/owner/repo、https://gitlab.com/owner/repo、https://codeberg.org/owner/repo、https://bitbucket.org/workspace/repo"
                             FontFamily="Consolas, Cascadia Mono, monospace"/>

                    <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding HasRecentRepositories}">
                        <ComboBox ItemsSource="{Binding RecentRepositories}"
                                  SelectedItem="{Binding SelectedRecentRepository}"
                                  HorizontalAlignment="Stretch"
                                  PlaceholderText="最近使用的 repository（本地與遠端分開顯示）">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="models:RecentRepositoryEntry">
                                    <StackPanel Spacing="2" Margin="0,4">
                                        <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding RemoteSummary}" Classes="caption" FontSize="11" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding LocalSummary}" Classes="caption" FontSize="11" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding PagesSummary}" Classes="caption" FontSize="11" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <Button Grid.Column="1" Content="清除紀錄" Margin="8,0,0,0"
                                Command="{Binding ClearRecentRepositoriesCommand}"/>
                    </Grid>

                    <ComboBox ItemsSource="{Binding PagesRepositories}"
                              SelectedItem="{Binding SelectedPagesRepository}"
                              IsVisible="{Binding HasPagesRepositories}"
                              HorizontalAlignment="Stretch"
                              PlaceholderText="選擇已啟用 GitHub Pages 的 repository">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="models:GitHubPagesRepositoryItem">
                                <TextBlock Text="{Binding DisplayName}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <Border Background="#101720" BorderBrush="#2A3648" BorderThickness="1"
                            CornerRadius="8" Padding="12">
                        <TextBlock Text="{Binding RepositoryTargetSummary}" TextWrapping="Wrap"
                                   Classes="muted" LineHeight="20"/>
                    </Border>

                    <Grid ColumnDefinitions="*,Auto">
                        <TextBox Text="{Binding CloneParent}"
                                 PlaceholderText="本機存放父資料夾"/>
                        <Button Grid.Column="1" Content="選擇…" Margin="8,0,0,0"
                                Command="{Binding BrowseCloneParentCommand}"/>
                    </Grid>

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="列出我的 GitHub Pages 網站"
                                Command="{Binding ListPagesRepositoriesCommand}"
                                IsEnabled="{Binding !IsBusy}"
                                IsVisible="{Binding IsGitHubProvider}"/>
                        <Button Content="複製到本機並開啟" Classes="accent"
                                Command="{Binding CloneSiteToLocalCommand}"
                                IsEnabled="{Binding CanCloneToLocal}"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Classes="card" BorderBrush="#0E7490" BorderThickness="1"
                    IsVisible="{Binding HasLocalSite}">
                <StackPanel Spacing="12">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Spacing="3">
                            <TextBlock Text="連結既有 Repository" Classes="sectionTitle"/>
                            <TextBlock Text="貼上 GitHub、GitLab、Codeberg 或 Bitbucket repository / Pages 網址，Hugoer 會辨識平台、同步 baseURL，先直接讀取並合併遠端內容，再交由平台建置發布。"
                                       Classes="caption" TextWrapping="Wrap"/>
                        </StackPanel>
                        <Border Grid.Column="1" Classes="pill" Padding="10,4" VerticalAlignment="Top">
                            <TextBlock Text="推薦" Foreground="#67D8FF" FontWeight="SemiBold" FontSize="12"/>
                        </Border>
                    </Grid>

                    <TextBox Text="{Binding RepositoryUrl}"
                             PlaceholderText="https://github.com/owner/repo、https://gitlab.com/owner/repo、https://codeberg.org/owner/repo、https://bitbucket.org/workspace/repo"
                             FontFamily="Consolas, Cascadia Mono, monospace"/>

                    <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding HasRecentRepositories}">
                        <ComboBox ItemsSource="{Binding RecentRepositories}"
                                  SelectedItem="{Binding SelectedRecentRepository}"
                                  HorizontalAlignment="Stretch"
                                  PlaceholderText="最近使用的 repository（本地與遠端分開顯示）">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="models:RecentRepositoryEntry">
                                    <StackPanel Spacing="2" Margin="0,4">
                                        <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding RemoteSummary}" Classes="caption" FontSize="11" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding LocalSummary}" Classes="caption" FontSize="11" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding PagesSummary}" Classes="caption" FontSize="11" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <Button Grid.Column="1" Content="清除紀錄" Margin="8,0,0,0"
                                Command="{Binding ClearRecentRepositoriesCommand}"/>
                    </Grid>

                    <Border Background="#101720" BorderBrush="#2A3648" BorderThickness="1"
                            CornerRadius="8" Padding="12">
                        <TextBlock Text="{Binding RepositoryTargetSummary}" TextWrapping="Wrap"
                                   Classes="muted" LineHeight="20"/>
                    </Border>

                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Spacing="3" VerticalAlignment="Center">
                            <CheckBox Content="將 hugo.toml 的 baseURL 同步為建議 Pages 網址"
                                      IsChecked="{Binding SyncRecommendedBaseUrl}"/>
                            <TextBlock Text="若遠端已有 README，會先安全取得並保留；遇到衝突立即停止，不會 force push。"
                                       Classes="caption" TextWrapping="Wrap"/>
                        </StackPanel>
                        <Button Grid.Column="1" Content="連結、推送並設定 Pages"
                                Classes="accent" Command="{Binding ConnectExistingRepositoryCommand}"
                                IsEnabled="{Binding CanConnectRepository}" Margin="16,0,0,0"
                                VerticalAlignment="Center"/>
                    </Grid>
                </StackPanel>
            </Border>

            <Grid ColumnDefinitions="*,*" IsVisible="{Binding HasLocalSite}">
                <Border Classes="card" Margin="0,0,6,0">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Repository 連線" Classes="sectionTitle"/>
                        <TextBlock Text="{Binding RemoteSummary}" Classes="muted" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
                <Border Classes="card" Grid.Column="1" Margin="6,0,0,0">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Pages / 靜態網站狀態" Classes="sectionTitle"/>
                        <TextBlock Text="{Binding PagesSummary}" Classes="muted" TextWrapping="Wrap"/>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="查詢 Pages 狀態" Command="{Binding RefreshPagesStatusCommand}"
                                    IsEnabled="{Binding !IsBusy}"/>
                            <Button Content="開啟 Repository" Command="{Binding OpenRepositoryUrlCommand}"
                                    IsEnabled="{Binding CanConnectRepository}"/>
                            <Button Content="開啟網站" Command="{Binding OpenPagesUrlCommand}"/>
                            <Button Content="啟用 / 顯示平台提示" Command="{Binding EnablePagesCommand}"
                                    IsEnabled="{Binding !IsBusy}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <Border Classes="card deploymentMonitor" IsVisible="{Binding HasLocalSite}">
                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                    <StackPanel Spacing="5" Margin="0,0,20,0">
                        <TextBlock Text="線上版本監控" Classes="sectionTitle"/>
                        <TextBlock Text="{Binding DeploymentMonitorTitle}"
                                   FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding DeploymentMonitorSummary}"
                                   Classes="muted" TextWrapping="Wrap" LineHeight="20"/>
                        <TextBlock Text="{Binding DeploymentMonitorSchedule}"
                                   Classes="caption" TextWrapping="Wrap"/>
                    </StackPanel>
                    <Button Grid.Column="1"
                            Content="立即檢查線上版本"
                            Command="{Binding CheckDeploymentNowCommand}"
                            IsEnabled="{Binding !IsCheckingDeployment}"
                            VerticalAlignment="Center"/>
                    <ProgressBar Grid.Row="1" Grid.ColumnSpan="2"
                                 Margin="0,12,0,0" Height="3"
                                 IsIndeterminate="True"
                                 IsVisible="{Binding IsCheckingDeployment}"/>
                </Grid>
            </Border>

            <Border Classes="card" IsVisible="{Binding HasLocalSite}">
                <StackPanel Spacing="10">
                    <TextBlock Text="遠端發佈更新" Classes="sectionTitle"/>
                    <TextBlock Text="{Binding ProviderHint}" Classes="muted" TextWrapping="Wrap"/>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="{Binding PublishButtonText}" Classes="accent"
                                Command="{Binding PushCommand}"
                                IsEnabled="{Binding !IsBusy}"/>
                        <Button Content="本機部署備援"
                                Command="{Binding DeployLocallyCommand}"
                                IsEnabled="{Binding !IsBusy}"
                                IsVisible="{Binding IsRemoteDeploymentMode}"/>
                    </StackPanel>
                    <TextBlock Classes="caption" TextWrapping="Wrap"
                               Text="遠端模式不會先執行本機 hugo build：GitHub 使用 Actions 建置 Pages；GitLab 使用 .gitlab-ci.yml；Codeberg／Bitbucket 依平台分支與靜態網站規則發布。"/>
                </StackPanel>
            </Border>

            <Border Classes="card" IsVisible="{Binding IsGitHubProvider}">
                <StackPanel Spacing="12">
                    <TextBlock Text="建立新的 GitHub Repository" Classes="sectionTitle"/>
                    <Grid ColumnDefinitions="120,*" RowDefinitions="Auto,Auto">
                        <TextBlock Text="Repo 名稱" VerticalAlignment="Center" Margin="0,0,0,8"/>
                        <TextBox Grid.Column="1" Text="{Binding RepoName}"
                                 PlaceholderText="my-hugo-site（只填名稱；已有的 Hugo repo 會改為連結）" Margin="0,0,0,8"/>
                        <TextBlock Grid.Row="1" Text="可見性" VerticalAlignment="Center"/>
                        <CheckBox Grid.Row="1" Grid.Column="1" Content="Public repository"
                                  IsChecked="{Binding IsPublicRepo}"/>
                    </Grid>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="建立新 Repo + 推送 + 啟用 Pages" Classes="accent"
                                Command="{Binding CreateAndDeployCommand}"
                                IsEnabled="{Binding !IsBusy}"/>
                    </StackPanel>
                    <TextBlock Classes="caption" TextWrapping="Wrap"
                               Text="若 GitHub 上已有同名 repository，且是 Hugo 網站（或空的／只有 README），會改走「連結既有」：保留遠端內容、衝突即停、不 force push。名稱被其他專案占用時會拒絕建立。"/>
                    <TextBlock Classes="caption" TextWrapping="Wrap"
                               Text="自動建立新 repository 目前只支援 GitHub。GitLab、Codeberg、Bitbucket 請先在平台建立 repository，貼上網址後用上方「連結、推送並設定 Pages」。"/>
                </StackPanel>
            </Border>

            <Border Classes="card">
                <StackPanel Spacing="8">
                    <TextBlock Text="操作日誌" Classes="sectionTitle"/>
                    <TextBox Text="{Binding Log}"
                             IsReadOnly="True"
                             AcceptsReturn="True"
                             Classes="logBox"
                             MinHeight="160"
                             FontFamily="Consolas, Cascadia Mono, monospace"/>
                    <TextBlock Text="{Binding StatusMessage}" Classes="muted"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
