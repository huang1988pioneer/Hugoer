<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Hugoer.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1180" d:DesignHeight="760"
        x:Class="Hugoer.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Width="1180" Height="760"
        MinWidth="960" MinHeight="640"
        Title="Hugoer — Hugo 一站式工作台"
        TransparencyLevelHint="None">

    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <Grid RowDefinitions="Auto,Auto,*">
        <Border Grid.Row="0" Classes="topBar" Padding="16,12">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <TextBlock Text="Hugoer" Classes="appTitle" VerticalAlignment="Center"/>
                    <Border Classes="pill" Padding="10,4" VerticalAlignment="Center">
                        <TextBlock Text="{Binding SiteBanner}" Classes="muted" TextWrapping="NoWrap"/>
                    </Border>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <Border Classes="codeStats" Padding="10,5"
                            ToolTip.Tip="{Binding CodeStatisticsDetails}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="程式碼統計" Classes="caption"
                                       Foreground="#9EDFF2" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding CodeStatisticsSummary}"
                                       Foreground="#FFFFFF" FontSize="15" FontWeight="SemiBold"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <TextBlock Text="{Binding AppStatus}"
                               Classes="muted"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1" Classes="navigationBar" Padding="12,6">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                <ListBox ItemsSource="{Binding NavItems}"
                         SelectedItem="{Binding SelectedNav}"
                         Classes="navList"
                         Background="Transparent"
                         ScrollViewer.HorizontalScrollBarVisibility="Auto"
                         ScrollViewer.VerticalScrollBarVisibility="Disabled">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:NavItem">
                            <TextBlock Text="{Binding Title}"
                                       ToolTip.Tip="{Binding Description}"
                                       FontWeight="SemiBold"
                                       FontSize="14"
                                       VerticalAlignment="Center"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <StackPanel Grid.Column="1" Orientation="Vertical" Spacing="2"
                            HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="Hugo · Themes · Pages" Classes="caption"/>
                    <TextBlock Text="Local tool · Traditional Chinese UI" Classes="caption"/>
                </StackPanel>
            </Grid>
            </Border>

        <Border Grid.Row="2" Classes="contentHost" Padding="0">
            <ContentControl Content="{Binding CurrentPage}" Margin="0"/>
        </Border>
    </Grid>
</Window>
